{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "env": {
    "MONGODB_URI": {
      "description": "MongoDB connection string"
    },
    "JWT_SECRET": {
      "description": "JWT secret key for authentication"
    },
    "PORT": {
      "default": "4000"
    }
  }
}
