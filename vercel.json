{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "env": {
    "MONGODB_URI": {
      "description": "MongoDB Atlas connection string"
    },
    "JWT_SECRET": {
      "description": "JWT secret key for authentication (min 32 characters)"
    },
    "CLOUDINARY_CLOUD_NAME": {
      "description": "Cloudinary cloud name from dashboard"
    },
    "CLOUDINARY_API_KEY": {
      "description": "Cloudinary API key from dashboard"
    },
    "CLOUDINARY_API_SECRET": {
      "description": "Cloudinary API secret from dashboard"
    },
    "NODE_ENV": {
      "default": "production"
    }
  }
}
